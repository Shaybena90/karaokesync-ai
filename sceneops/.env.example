# SceneOps AI – קובץ תצורה לדוגמה. העתיקו ל-.env (setup.ps1 עושה זאת אוטומטית).
# אין לשמור בקובץ זה סיסמאות למכשירים או מידע רגיש.

# מסד נתונים: ריק = SQLite מקומי ב-data\sceneops.db
# ל-PostgreSQL בעתיד: postgresql+psycopg://user:password@localhost:5432/sceneops  (נדרשת התקנת psycopg)
SCENEOPS_DATABASE_URL=

# תיקיית נתונים ואחסון עותקי עבודה/דוחות (חייבת להיות נפרדת מתיקיות המקור)
# SCENEOPS_DATA_DIR=C:\SceneOps\data
# SCENEOPS_STORAGE_ROOT=C:\SceneOps\data\storage

# תיקיות מקור מורשות בהתקנה הראשונית (מופרדות ב-;). בהמשך מנוהלות במסך ההגדרות.
# SCENEOPS_INITIAL_SOURCE_ROOTS=C:\SceneOps\sample_data\evidence;E:\

# מצב הדגמה: מאפשר כניסה עם משתמשי דמו בדויים. יש לכבות לפני כל שימוש אמיתי.
SCENEOPS_DEMO_MODE=true
SCENEOPS_SESSION_HOURS=8

# נתיבי FFmpeg (אם אינם ב-PATH)
SCENEOPS_FFMPEG_PATH=ffmpeg
SCENEOPS_FFPROBE_PATH=ffprobe

SCENEOPS_MAX_UPLOAD_MB=25
SCENEOPS_HASH_CHUNK_MB=4
SCENEOPS_DISPLAY_TIMEZONE=Asia/Jerusalem
SCENEOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
