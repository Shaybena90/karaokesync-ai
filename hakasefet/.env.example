# Online co-op for the classic rooms (Supabase Realtime). Public values only — never a service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The two-player room "שני צדדים של הדלת": address of the pair server (server/pair-server.ts).
# Empty = ws://<same host>:8787. A site served over HTTPS needs a wss:// address.
VITE_PAIR_SERVER_URL=

# Port for `npm run pair-server` (server only, not used by the browser).
PAIR_PORT=8787
