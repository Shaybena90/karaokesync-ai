# =====================================================================
# KaraokeSync AI — environment variables
# Copy this file to ".env" (in the same folder) and fill in the values.
# NEVER commit the real .env file — it is already in .gitignore.
# =====================================================================

# development | production
APP_ENV=development

# ---------------------------------------------------------------------
# Browser (website) — anything starting with VITE_ is PUBLIC.
# Only put public values here. NEVER the service role key.
# Supabase dashboard → Project Settings → API
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=
# "anon public" key (or the new "publishable" key: sb_publishable_...)
VITE_SUPABASE_ANON_KEY=
# Address of the Python API (locally: http://localhost:8000)
VITE_API_URL=http://localhost:8000
# Set to true only after enabling Google in Supabase → Authentication → Providers
VITE_ENABLE_GOOGLE_AUTH=false

# ---------------------------------------------------------------------
# Server (API + worker) — SECRET, never put in the browser / Vercel frontend
# ---------------------------------------------------------------------
SUPABASE_URL=
# "service_role" key (or the new secret key: sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=

# Website addresses allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_AUDIO_DURATION_SECONDS=600
MAX_UPLOADS_PER_DAY=20
MAX_ACTIVE_JOBS_PER_USER=2
MAX_RETRIES_PER_DAY=10

# Retention: audio files older than this are deleted automatically
AUDIO_RETENTION_DAYS=30
# Uploads that were started but never finished are removed after this
ABANDONED_UPLOAD_HOURS=24

# ---------------------------------------------------------------------
# Worker (AI processing)
# ---------------------------------------------------------------------
# Whisper model: tiny | base | small | medium | large-v3 (best, slowest)
# On a regular computer without a GPU start with "small".
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
# auto | int8 | float16 | int8_float16
WHISPER_COMPUTE_TYPE=auto
# Vocal separation with Demucs (slow on CPU; recommended on GPU)
ENABLE_VOCAL_SEPARATION=false
DEMUCS_MODEL=htdemucs
WORKER_POLL_SECONDS=3
WORKER_LEASE_SECONDS=120
